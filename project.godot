; Bolt Yard — native Android mechanical sandbox prototype.
config_version=5

[application]
config/name="Bolt Yard"
config/version="3.0.0"
run/main_scene="res://offroad_main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://art/icon.svg"

[display]
window/size/viewport_width=720
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.09, 0.13, 0.17, 1)

[physics]
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=16
3d/default_gravity=9.81

[input_devices]
pointing/android/enable_pan_and_scale_gestures=false
pointing/emulate_mouse_from_touch=true

